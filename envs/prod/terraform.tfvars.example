# Copy to terraform.tfvars (git-ignored) and fill in. Nothing here is a real value.
region = "eu-central-1"

# Required: this environment runs APP_ENV=prod, which needs an https origin.
domain_name    = "prod.example.com"
hosted_zone_id = "Z0000000000000000000"

alarm_email = "ops@example.com"

# Set by the deploy workflow; leave empty for the first plan.
services_image_tag = ""
migrate_image_tag  = ""
